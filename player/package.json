{
  "name": "@signage/player",
  "version": "0.1.0",
  "private": true,
  "description": "Electron kiosk player for the digital signage platform.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
