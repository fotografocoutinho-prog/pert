# ObraConnect — configuração de ambiente
# Copie para .env e ajuste. NUNCA coloque o .env dentro de public_html.
# Valores marcados com [cPanel] dizem respeito ao alojamento partilhado.

APP_NAME=ObraConnect
APP_ENV=production
# Gerar com: php artisan key:generate  (ou na página /instalar não é preciso: gere localmente e cole aqui)
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.exemplo.pt

APP_LOCALE=pt_PT
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logs diários, 14 dias
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

# [cPanel] Base de dados criada em "Bases de dados MySQL". O nome e o utilizador
# têm o prefixo da conta (ex.: conta_obraconnect). Use "mariadb" se o servidor for MariaDB.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=conta_obraconnect
DB_USERNAME=conta_obra
DB_PASSWORD=

# [cPanel] Sem Redis: sessões, cache e filas em base de dados.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
# O agendador (cron) lança um worker por minuto. Em VPS com supervisor: false.
QUEUE_RUN_VIA_SCHEDULER=true

BROADCAST_CONNECTION=log

# Domínios da SPA que usam sessão por cookie (o domínio do APP_URL, sem https://)
SANCTUM_STATEFUL_DOMAINS=app.exemplo.pt

# Ficheiros privados das empresas: "private" (storage/app/private) ou "s3"
OBRA_PRIVATE_DISK=private
FILESYSTEM_DISK=local

# S3 compatível (AWS, Wasabi, Backblaze B2, ...). Opcional.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# [cPanel] Conta de email criada no cPanel (SMTP com SSL na porta 465)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.exemplo.pt
MAIL_PORT=465
MAIL_USERNAME=nao-responder@exemplo.pt
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="nao-responder@exemplo.pt"
MAIL_FROM_NAME="${APP_NAME}"

# Segurança
FORCE_HTTPS=true
CSP_ENABLED=true
PLATFORM_REQUIRES_MFA=true
# Verifica passwords contra fugas conhecidas (Have I Been Pwned). Requer acesso HTTPS de saída.
PASSWORD_CHECK_UNCOMPROMISED=true
# Proxies de confiança (ex.: Cloudflare). "*" só se TODO o tráfego passar pelo proxy.
TRUSTED_PROXIES=

# Subscrições
OBRA_TRIAL_PLAN=professional
OBRA_TRIAL_DAYS=30
OBRA_PAST_DUE_GRACE_DAYS=14
OBRA_READ_ONLY_DAYS=30

# Instalação sem SSH: defina um valor aleatório com 32+ caracteres, abra /instalar
# e APAGUE esta linha depois de criar o super administrador.
SETUP_TOKEN=

VITE_APP_NAME="${APP_NAME}"
