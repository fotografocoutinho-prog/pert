# ---- Database ----
# Admin/superuser role: runs migrations and provisions the runtime role.
POSTGRES_USER=signage
POSTGRES_PASSWORD=signage
POSTGRES_DB=signage
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Runtime role (NON-superuser) the API connects as, so Row-Level Security is
# enforced. Must differ from POSTGRES_USER. Auto-provisioned during migration.
APP_DB_USER=signage_app
APP_DB_PASSWORD=change-me-app-db-password

# ---- Scaling / storage / metrics (optional) ----
# REDIS_URL=redis://localhost:6379          # enables the distributed WS hub
# STORAGE_DRIVER=s3                          # default: local
# S3_BUCKET=  S3_REGION=  S3_ENDPOINT=  S3_ACCESS_KEY_ID=  S3_SECRET_ACCESS_KEY=
# METRICS_TOKEN=                             # protects GET /metrics if set

# ---- API ----
API_PORT=4000
NODE_ENV=development

# Secrets (CHANGE IN PRODUCTION)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# CORS origin of the backoffice
CORS_ORIGIN=http://localhost:5173

# Local file storage root
STORAGE_DIR=./storage

# ---- Backoffice ----
VITE_API_URL=http://localhost:4000
