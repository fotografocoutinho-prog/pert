# ============================================================================
#  1000viagens — configuração do Apache (cPanel)
#  Coloque este ficheiro na raiz do site (normalmente public_html/).
# ============================================================================

Options -Indexes
DirectoryIndex index.php index.html

AddDefaultCharset UTF-8
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
</IfModule>

# ── Endereços ───────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # ►► HTTPS: retire o # das duas linhas seguintes depois de instalar o
  #    certificado SSL no cPanel (Segurança → SSL/TLS Status).
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # ►► Um só domínio (evita conteúdo duplicado aos olhos do Google).
  #    Escolha UMA das duas versões e retire o # dessas linhas.
  # De www para sem www:
  # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  # RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
  # De sem www para www:
  # RewriteCond %{HTTP_HOST} !^www\. [NC]
  # RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [R=301,L]

  # API
  RewriteRule ^api/public/config/?$ api/config.php [L]
  RewriteRule ^api/leads/?$ api/leads.php [L,QSA]
  RewriteRule ^api/admin/.*$ api/admin.php [L,QSA]

  # /index.html é a mesma página que / — uma só versão para o Google
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  # Backoffice e páginas com endereço limpo
  RewriteRule ^admin/?$ admin.html [L]
  RewriteRule ^backoffice/?$ admin.html [L]
  RewriteRule ^privacidade/?$ privacidade.html [L]
  RewriteRule ^politica-de-privacidade/?$ privacidade.html [L]

  # Barra final nas páginas de destino (/viagens/maldivas → /viagens/maldivas/)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

ErrorDocument 404 /404.html

# ── Compressão (páginas mais rápidas = melhor posição no Google) ────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml image/svg+xml
  AddOutputFilterByType DEFLATE application/manifest+json
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ── Cache do navegador ──────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 month"
  ExpiresByType image/x-icon              "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType text/css                  "access plus 7 days"
  ExpiresByType application/javascript    "access plus 7 days"
  ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # O HTML é sempre revalidado, para uma alteração no backoffice aparecer já
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|png|jpg|jpeg|webp|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # ── Segurança ──
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header always unset X-Powered-By
  # ►► Depois de o HTTPS estar a funcionar bem durante uns dias, retire o #:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ── Proteger ficheiros que não devem ser servidos ───────────────────────────
<FilesMatch "^(\.env|\.htaccess|\.gitignore|composer\.(json|lock)|package(-lock)?\.json|README\.md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
