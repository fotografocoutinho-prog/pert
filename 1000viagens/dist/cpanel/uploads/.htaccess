# Imagens enviadas pelo backoffice: servidas, mas nunca executadas.
Options -Indexes -ExecCGI
<FilesMatch "\.(php|phtml|phps|php[0-9]|phar|cgi|pl|py|sh)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_headers.c>
  # Um SVG enviado por engano nunca corre scripts
  Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src data:"
  Header set X-Content-Type-Options "nosniff"
</IfModule>
