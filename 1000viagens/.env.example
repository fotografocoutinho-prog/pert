# ─────────────────────────────────────────────────────────────
# 1000viagens — configuração do servidor
# Copie para .env (ou defina como variáveis de ambiente no host)
# ─────────────────────────────────────────────────────────────

# Porta HTTP (Railway/Render/Fly definem PORT automaticamente)
PORT=3000

# Password inicial do backoffice (/admin).
# É usada apenas na primeira arrancada, para criar a conta.
# Depois disso mude-a dentro do backoffice → Segurança.
ADMIN_PASSWORD=mudar-esta-password

# Segredo usado para assinar as sessões do backoffice.
# Gere um valor aleatório: node -e "console.log(crypto.randomUUID())"
SESSION_SECRET=

# Pasta onde ficam os dados (JSON + uploads). Por omissão: ./data
DATA_DIR=./data

# Opcional: envio de cópia dos pedidos para um webhook (Zapier, Make, n8n…)
# Também configurável no backoffice → Integrações.
LEADS_WEBHOOK_URL=
