# Dados de produção: pedidos, definições, sessões e uploads.
# Nunca entram no repositório — são a base de dados do site.
# A pasta é criada automaticamente no arranque do servidor.
/data/

# Ambiente
.env
.env.local

# Sistema
node_modules/
*.log
.DS_Store

# O pacote pronto para cPanel é versionado de propósito: assim pode ser
# descarregado do GitHub sem ter de instalar nada.
# (Regenera-se sempre com: npm run build:cpanel)
!/dist/
!/dist/**
